Windows Registry Editor Version 5.00

; Запасное снятие политик блокировки браузеров для ТЕКУЩЕГО пользователя (HKCU) и автозапуска.
; Двойной клик → «Да». Службу не трогает (используйте emergency.ps1 для полного удаления).

[-HKEY_CURRENT_USER\Software\Policies\Microsoft\Edge\URLBlocklist]
[-HKEY_CURRENT_USER\Software\Policies\Microsoft\Edge\IncognitoModeUrlBlocklist]
[-HKEY_CURRENT_USER\Software\Policies\Google\Chrome\URLBlocklist]
[-HKEY_CURRENT_USER\Software\Policies\Google\Chrome\IncognitoModeUrlBlocklist]
[-HKEY_CURRENT_USER\Software\Policies\Chromium\URLBlocklist]
[-HKEY_CURRENT_USER\Software\Policies\Vivaldi\URLBlocklist]
[-HKEY_CURRENT_USER\Software\Policies\Vivaldi\IncognitoModeUrlBlocklist]
[-HKEY_CURRENT_USER\Software\Policies\BraveSoftware\Brave\URLBlocklist]
[-HKEY_CURRENT_USER\Software\Policies\YandexBrowser\URLBlocklist]
[-HKEY_CURRENT_USER\Software\Policies\YandexBrowser\IncognitoModeUrlBlocklist]
[-HKEY_CURRENT_USER\Software\Policies\Mozilla\Firefox\WebsiteFilter]
[-HKEY_CURRENT_USER\Software\Policies\Mozilla\Firefox\DNSOverHTTPS]

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Run]
"SiteBlocker"=-
