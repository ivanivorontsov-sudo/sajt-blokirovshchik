<Project Sdk="Microsoft.NET.Sdk">
  <!-- Служба Windows (LocalSystem): источник истины, watchdog, политики браузеров, named pipe.
       Собирается как библиотека и хостится тем же SiteBlocker.exe с ключом service. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SiteBlocker.Service</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SiteBlocker.Core\SiteBlocker.Core.csproj" />
  </ItemGroup>
</Project>
